# Byte-compiled / cache
__pycache__/
*.py[cod]

# Virtualenv
.venv/
venv/

# Django
# Phase 6 moved the canonical database to PostgreSQL. Any db.sqlite3 left in a
# working tree is a leftover from Phases 1-5 and is safe to delete — it was only
# ever local development data.
db.sqlite3
db.sqlite3-journal
/staticfiles/
# User uploads. With DJANGO_STORAGE_BACKEND=private-local (development and tests)
# placement audio lands here; nothing serves it, and there is no MEDIA_URL. In
# production it goes to a private bucket instead.
/media/
*.log

# Environment
.env

# Editors / OS
.idea/
.vscode/
.DS_Store
.claude/settings.local.json
