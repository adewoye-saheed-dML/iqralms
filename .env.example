# Environment variables the application reads, with development values.
#
#   cp .env.example .env
#
# `.env` is gitignored. Nothing loads it automatically — this project reads the
# process environment, so export it yourself, use `set -a; . ./.env; set +a`, or
# let your process manager do it. That is deliberate: an env file that is picked
# up implicitly is an env file you forget is there.
#
# NEVER put a real secret, a real bucket name tied to private infrastructure, or
# production credentials in a committed file (CLAUDE.md). Everything below either
# reaches only your own machine or is obviously fake.


# --- Required -----------------------------------------------------------------

# PostgreSQL, and PostgreSQL only. There is no SQLite fallback: a missing or
# non-PostgreSQL URL fails at startup with a message telling you what to do.
#   docker compose:   postgres://quran:quran@localhost:5432/quran
#   local socket:     postgres:///quran
DATABASE_URL=postgres://quran:quran@localhost:5432/quran


# --- Development toggles ------------------------------------------------------

# DEBUG defaults to False (Phase 6 inverted this). Development opts in.
DJANGO_DEBUG=1

# Falls back to a committed development key when unset, which is fine locally and
# refused outright under DJANGO_PRODUCTION=1. Generate a real one with:
#   python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
# DJANGO_SECRET_KEY=

# Comma separated. Defaults to localhost,127.0.0.1,[::1] in development and is
# *required* under DJANGO_PRODUCTION=1 — there is no wildcard default.
# DJANGO_ALLOWED_HOSTS=api.example.com

# 's3' (an S3-compatible private bucket) or 'private-local' (local disk, no
# public URL, signed access through a Django view). Defaults to private-local in
# development and s3 in production, where private-local is refused.
DJANGO_STORAGE_BACKEND=private-local

# Where private-local keeps uploads. Not served by anything: there is no
# MEDIA_URL and no media route.
# DJANGO_MEDIA_ROOT=/var/lib/quran/media

# How long a placement-audio URL stays usable, in seconds.
# DJANGO_PLACEMENT_AUDIO_URL_TTL=300

# Managed video. The free managed Jitsi tier is the default.
# JITSI_DOMAIN=meet.jit.si


# --- Object storage (DJANGO_STORAGE_BACKEND=s3) --------------------------------
# The values below match docker-compose.yml's MinIO service, so uncommenting them
# and setting DJANGO_STORAGE_BACKEND=s3 develops against a real private bucket.
# For AWS itself, leave AWS_S3_ENDPOINT_URL unset and keep the default virtual
# addressing style.
#
# Credentials are optional and better left unset in a deployment that can use an
# instance role or IRSA — boto3 finds those itself.

# AWS_STORAGE_BUCKET_NAME=quran-placement-audio
# AWS_S3_ENDPOINT_URL=http://localhost:9000
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ADDRESSING_STYLE=path
# AWS_ACCESS_KEY_ID=quranminio
# AWS_SECRET_ACCESS_KEY=quranminio


# --- Production ---------------------------------------------------------------
# DJANGO_PRODUCTION=1 is the explicit flag that turns on the HTTPS-deployment
# settings *and* the hard requirements: a real DJANGO_SECRET_KEY, explicit
# DJANGO_ALLOWED_HOSTS, and DJANGO_STORAGE_BACKEND=s3. It is separate from DEBUG
# so a staging box behind TLS can have these without looking like production in
# any other way. DEBUG and PRODUCTION together is refused.
#
# Verify a configuration before shipping it:
#   python manage.py check --deploy --fail-level WARNING

# DJANGO_PRODUCTION=1

# Everything below has a sensible production default and only needs setting to
# deviate from it.

# TLS terminates at a proxy, which is assumed to set X-Forwarded-Proto. Turn the
# redirect off only if something in front of the app already does it.
# DJANGO_SECURE_SSL_REDIRECT=1

# HSTS: one year, with subdomains and preload. A browser that has seen this
# header refuses plain HTTP for the whole duration, so a first deploy may want to
# start short (3600) and ratchet up once TLS is known good.
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# DJANGO_SECURE_HSTS_PRELOAD=1

# Scheme-qualified, comma separated. Needed for a browser client on a different
# host from the API.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# Set to 0 if a browser client needs to read the CSRF cookie from JavaScript.
# DJANGO_CSRF_COOKIE_HTTPONLY=1

# Managed PostgreSQL usually wants 'require' or stricter. Left unset locally,
# where a socket or container offers no TLS at all.
# DJANGO_DB_SSLMODE=require

# Seconds to keep a database connection open. 0 hands it straight back, which is
# what a PgBouncer deployment wants.
# DJANGO_DB_CONN_MAX_AGE=600
